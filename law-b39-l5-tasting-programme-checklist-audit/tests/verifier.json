  {
   "name": "answer_exists",
   "metadata": {
    "how_justification": "Checks answer.md is present as a file in the workspace.",
    "why_justification": "The review is in the submission.",
    "tag": "core"
   },
   "source": {
    "type": "file",
    "file": {
     "type": "filesystem",
     "command": "check_path_exists",
     "arguments": {
      "path": "answer.md"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": true,
    "deterministic": {
     "path": "$.is_file",
     "comparison": "equals"
    }
   }
  },
  {
   "name": "answer_prose_floor",
   "metadata": {
    "how_justification": "Opens answer.md with md.extract_text and applies regex_match: a sixty-word prose floor, and at least three governing-section citations in BR-/AG- form.",
    "why_justification": "The review runs to sixty words of sentences at least and cites the sections it turns on, which submission_format.md asks for; a length-only floor let a keyword-stuffed stub score. Matched on the citation form rather than on named sections or phrasing, so any correct review that cites its authorities passes (QC1-2 / D1).",
    "tag": "core"
   },
   "source": {
    "type": "file",
    "file": {
     "type": "md",
     "command": "extract_text",
     "arguments": {
      "path": "answer.md"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?is)(?=(?:.*?\\b(?:BR|AG)-\\d{3}\\b){3,})(?:[A-Za-z]+[^A-Za-z]+){60,}",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
