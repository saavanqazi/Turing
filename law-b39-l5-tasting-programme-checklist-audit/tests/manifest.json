  {
   "name": "register_exists",
   "metadata": {
    "how_justification": "Checks checklist_audit.csv is present as a file.",
    "why_justification": "The audit table is in the submission.",
    "tag": "core"
   },
   "source": {
    "type": "file",
    "file": {
     "type": "filesystem",
     "command": "check_path_exists",
     "arguments": {
      "path": "checklist_audit.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": true,
    "deterministic": {
     "path": "$.is_file",
     "comparison": "equals"
    }
   }
  },
  {
   "name": "register_header",
   "metadata": {
    "how_justification": "Opens checklist_audit.csv with csv.extract_text and applies regex_match.",
    "why_justification": "The layout names the header and it is matched exactly.",
    "tag": "core"
   },
   "source": {
    "type": "file",
    "file": {
     "type": "csv",
     "command": "extract_text",
     "arguments": {
      "path": "checklist_audit.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?i)\\A\\x22?item_id\\x22?[ \\t]*,[ \\t]*\\x22?mention_count\\x22?[ \\t]*,[ \\t]*\\x22?status\\x22?[ \\t]*,[ \\t]*\\x22?governing_section\\x22?[ \\t]*\\r?\\n",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
  {
