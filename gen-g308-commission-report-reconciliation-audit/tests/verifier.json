  {
   "name": "rate_mismatch_present",
   "metadata": {
    "how_justification": "Opens commission_findings.csv with csv.extract_text and applies regex_match.",
    "why_justification": "The underpaid new-business line is flagged."
   },
   "source": {
    "type": "file",
    "file": {
     "type": "csv",
     "command": "extract_text",
     "arguments": {
      "path": "commission_findings.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?mi)^\\x22?DEAL-03\\x22?\\s*,[^\\n]*RATE_MISMATCH",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
  {
   "name": "unmatched_present",
   "metadata": {
    "how_justification": "Opens commission_findings.csv with csv.extract_text and applies regex_match.",
    "why_justification": "The unmatched renewal line is flagged."
   },
   "source": {
    "type": "file",
    "file": {
     "type": "csv",
     "command": "extract_text",
     "arguments": {
      "path": "commission_findings.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?mi)^\\x22?DEAL-04\\x22?\\s*,[^\\n]*UNMATCHED_TO_LEDGER",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
  {
   "name": "duplicate_present",
   "metadata": {
    "how_justification": "Opens commission_findings.csv with csv.extract_text and applies regex_match.",
    "why_justification": "The duplicated deal id is flagged."
   },
   "source": {
    "type": "file",
    "file": {
     "type": "csv",
     "command": "extract_text",
     "arguments": {
      "path": "commission_findings.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?mi)^\\x22?DEAL-06\\x22?\\s*,[^\\n]*DUPLICATE_LINE",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
  {
   "name": "trap_not_flagged",
   "metadata": {
    "how_justification": "Opens commission_findings.csv with csv.extract_text and applies regex_match.",
    "why_justification": "The VP-approved override line must not be flagged."
   },
   "source": {
    "type": "file",
    "file": {
     "type": "csv",
     "command": "extract_text",
     "arguments": {
      "path": "commission_findings.csv"
     }
    }
   },
   "assertion": {
    "type": "deterministic",
    "expected": "(?s)^(?!.*\\bDEAL-07\\b[^\\n]*\\b(?:RATE_MISMATCH|UNMATCHED_TO_LEDGER|DUPLICATE_LINE)\\b).*$",
    "deterministic": {
     "path": "$.text",
     "comparison": "regex_match"
    }
   }
  },
  {
